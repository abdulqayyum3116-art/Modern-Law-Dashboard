# Supabase (already set in Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://wxgjachpperfpuggqssu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Recovery Webhook (Instant "Retry now" from dashboard)
# Make.com -> "Recovery - Retry Queue Drainer (Manual Trigger - Dashboard)" Webhook URL
# ---------------------------------------------------------------------------
RECOVERY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Make.com health poller  ->  /api/make-health
# Pulls failed Make executions into system_logs so they show on Activity & Logs
# instead of only in the client's email. All three are required for it to run.
# ---------------------------------------------------------------------------

# Make -> Profile -> API -> Add token. Scope needed: scenarios:read
MAKE_API_TOKEN=

# Bypasses RLS. The poller runs unattended (no user session), so it needs this
# to write system_logs. Supabase -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for schedulers. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`. Use any long random string.
CRON_SECRET=

# Optional — only if the account ever moves off the us2 zone / this team.
# MAKE_API_BASE=https://us2.make.com/api/v2
# MAKE_TEAM_ID=1555038

# ---------------------------------------------------------------------------
# Scheduling note
# ---------------------------------------------------------------------------
# The Vercel project is on the Hobby plan, where Cron Jobs run ONCE PER DAY.
# vercel.json therefore holds a daily safety-net run only. Coverage comes from:
#   1. the dashboard itself — syncs every ~10 min while someone has it open
#   2. the daily Vercel cron — catches up when nobody is watching
# For continuous 15-minute coverage, point any external scheduler
# (cron-job.org, GitHub Actions, an Uptime monitor) at:
#
#   POST https://modern-law-dashboard.vercel.app/api/make-health
#   Header: Authorization: Bearer <CRON_SECRET>
#
# …or upgrade the Vercel project to Pro, which allows minute-level crons.
